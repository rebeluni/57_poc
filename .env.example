# Base public URL of the deployed application or localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret administrator passcode required to unlock the /admin and /dashboard portals
ADMIN_PASSCODE=your-secure-admin-passcode

# Secret key used for signing session HMAC-SHA256 authentication cookies
AUTH_SECRET=your-random-32-char-hmac-secret-string

# Secret bearer token used to authenticate automated Vercel Cron calls to /api/cron/escalate
CRON_SECRET=your-cron-secret-token

# Public URL of your Supabase project (leave blank for zero-config in-memory demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key used for secure server-side database operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# (Optional) Google Gemini API Key used as a fallback AI classifier when rule confidence is low
GEMINI_API_KEY=your-optional-google-gemini-api-key
